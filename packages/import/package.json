{
  "name": "@webmio/import",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@webmio/model": "workspace:*",
    "@webmio/templates": "workspace:*",
    "cheerio": "catalog:",
    "css-tree": "catalog:",
    "domhandler": "catalog:"
  },
  "devDependencies": {
    "@types/css-tree": "catalog:",
    "@types/node": "catalog:",
    "@webmio/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
