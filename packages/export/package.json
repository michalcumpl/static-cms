{
  "name": "@webmio/export",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit && tsc -p scripts",
    "test": "vitest run",
    "clean": "rm -rf dist out .turbo",
    "demo": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-demo.ts"
  },
  "dependencies": {
    "@webmio/model": "workspace:*",
    "@webmio/render": "workspace:*",
    "@webmio/templates": "workspace:*",
    "fflate": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@webmio/tsconfig": "workspace:*",
    "html-validate": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
