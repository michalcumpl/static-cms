{
  "name": "@webmio/render",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@webmio/model": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@webmio/tsconfig": "workspace:*",
    "html-validate": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
