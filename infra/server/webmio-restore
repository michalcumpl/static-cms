#!/bin/sh
# Restores the admin's database before it starts (admin-on-aws design.md decision 3): from
# Litestream's replica, or from seed/app.db in the backups bucket when there is no replica yet.
# A database already on the disk is kept. Any error stops here, so the admin never starts empty
# because the replica couldn't be read.
set -eu
# shellcheck source=/dev/null
. /etc/webmio/server.env
data=/var/lib/webmio

mkdir -p "$data"
chown 1000:1000 "$data"
if [ -e "$data/app.db" ]; then
  echo "Keeping the database already in $data."
  exit 0
fi

docker run --rm --user 1000:1000 -v "$data:/data" \
  -v /etc/webmio/litestream.yml:/etc/litestream.yml:ro \
  "$WEBMIO_LITESTREAM_IMAGE" restore -if-replica-exists /data/app.db
if [ -e "$data/app.db" ]; then
  echo "Restored the database from the replica."
  exit 0
fi

if aws s3api head-object --region "$WEBMIO_REGION" --bucket "$WEBMIO_BACKUPS" \
  --key seed/app.db >/dev/null 2>&1; then
  aws s3 cp --region "$WEBMIO_REGION" --no-progress "s3://$WEBMIO_BACKUPS/seed/app.db" "$data/app.db.seed"
  chown 1000:1000 "$data/app.db.seed"
  mv "$data/app.db.seed" "$data/app.db"
  echo "Restored the database from seed/app.db."
else
  echo "No replica and no seed/app.db: the admin starts with an empty database."
fi
