# The redirect server's Caddy (bare-domain-redirect design.md decision 3). infra/src/redirect.ts
# fills in the admin's domain and the edge's "No website here" page.
{
	on_demand_tls {
		# Certificates only for bare domains connected to a website; asked on issuing and renewing.
		ask https://__ADMIN_DOMAIN__/hosting/bare-domain
	}
}

# A bare domain to its www., keeping the path and query.
https:// {
	tls {
		on_demand
	}
	header Cache-Control "public, max-age=86400"
	redir https://www.{host}{uri} 301
}

# HTTP doesn't ask the admin: any hostname goes straight to its own www.
http:// {
	handle /healthz {
		respond 200
	}
	@address expression `{host}.matches("^[0-9.]+$")`
	handle @address {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control no-store
		respond `__NO_WEBSITE__` 404
	}
	handle {
		header Cache-Control "public, max-age=86400"
		redir https://www.{host}{uri} 301
	}
}
